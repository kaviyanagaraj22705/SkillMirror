# ── SkillMirror local configuration ──────────────────────────────────────────
# Copy to `.env` and fill in the key. Nothing here is committed to git.

APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000

# Relative to the project root. Created automatically on first run.
DATABASE_PATH=data/skillmirror.db
UPLOAD_DIR=data/uploads

# ── OpenRouter (the only required secret) ────────────────────────────────────
# Get one at https://openrouter.ai/keys . Leave blank to run in degraded
# keyword-only mode: the app still scores gaps, but skips the LLM roadmap.
OPENROUTER_API_KEY=your_openrouter_api_key_here
 
# Google models reject provider.data_collection=deny (zero retention), which this app
# sends by default: OpenRouter answers 404 "Filter by Guardrails". Use a model with ZDR
# endpoints, or set OPENROUTER_DENY_DATA_COLLECTION=false to allow Google.
OPENROUTER_MODEL_EXTRACT=openai/gpt-4o-mini
OPENROUTER_MODEL_ROADMAP=anthropic/claude-sonnet-4.5
# OPENROUTER_MODEL_ROADMAP_FALLBACK=

# ── Behaviour ────────────────────────────────────────────────────────────────
LLM_ENABLED=true
LLM_CACHE_ENABLED=true
ROADMAP_DEFAULT_WEEKS=6
ROADMAP_DEFAULT_HOURS_PER_WEEK=8
MAX_ANALYSES_PER_HOUR=10

# ── OCR for scanned PDFs ────────────────────────────────────────────────────
# Resumes that are images (scans, photos) have no text layer. Set OCR_ENABLE=true
# and install Tesseract (https://github.com/UB-Mannheim/tesseract) for the app to
# read them. Without it, scanned PDFs fail with a clear error asking you to paste.
OCR_ENABLE=false
OCR_DPI=300
OCR_LANG=eng

# Prompt and document text are never logged. Set true only while debugging.
LOG_PROMPT_CONTENT=false
LOG_LEVEL=INFO
